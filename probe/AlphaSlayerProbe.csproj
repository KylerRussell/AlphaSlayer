<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <!-- Must match the "id" in alphaslayer_probe.json: ModManager looks for <id>.dll -->
    <AssemblyName>alphaslayer_probe</AssemblyName>
    <RootNamespace>AlphaSlayer.Probe</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Mod assemblies are side-loaded into the game's AssemblyLoadContext. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <NoWarn>$(NoWarn);CS0168;CS0219</NoWarn>
  </PropertyGroup>

  <!-- Point this at your install if it differs. -->
  <PropertyGroup>
    <Sts2Dir Condition="'$(Sts2Dir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Slay the Spire 2/data_sts2_linuxbsd_x86_64</Sts2Dir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=false / no copy: these already exist in the game process. -->
    <Reference Include="sts2">
      <HintPath>$(Sts2Dir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(Sts2Dir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(Sts2Dir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
